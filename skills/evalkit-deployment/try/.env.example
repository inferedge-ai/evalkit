# Copy to .env and fill in the LLM. docker compose and the evalkit CLI and SDK
# (next to evalkit.yaml) all read .env.
#
# EVALKIT_PORT=8020  # Host port the server publishes on; docker compose reads it

# Any OpenAI-compatible endpoint that supports tool calls and structured
# output: OpenAI, a LiteLLM proxy, vLLM, Ollama, ...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# The evalkit admin password on this machine.
EVALKIT_ADMIN_PASSWORD=evalkit-admin

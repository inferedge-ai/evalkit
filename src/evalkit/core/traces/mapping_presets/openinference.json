  "agent_name": {"attribute": "agent.name"},
  "input": {"attribute": "input.value", "json": true},
  "output": {"attribute": "output.value", "json": true},
  "known_attributes": [
    "openinference.span.kind", "session.id", "user.id", "metadata", "tag.tags",
    "input.mime_type", "output.mime_type", "llm.provider", "llm.system",
    "llm.invocation_parameters", "llm.finish_reason", "llm.tools.*",
    "llm.token_count.total", "llm.token_count.prompt_details.*",
    "llm.token_count.completion_details.*", "llm.cost.*", "tool.description",
    "tool.parameters", "tool.json_schema", "agent.name", "graph.node.*"
  ]
